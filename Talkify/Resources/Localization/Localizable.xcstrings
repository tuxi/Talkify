    "settings.auto_review_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Genehmigt zusätzliche Zugriffsanfragen automatisch, um Routineaufgaben reibungslos zu halten. Hochrisiko-Operationen erfordern weiterhin Ihre Bestätigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically approve additional access requests to keep routine tasks flowing. High-risk operations still require your confirmation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba automáticamente solicitudes de acceso adicionales para mantener las tareas rutinarias fluidas. Las operaciones de alto riesgo aún requieren tu confirmación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approuve automatiquement les demandes d'accès supplémentaires pour fluidifier les tâches courantes. Les opérations à haut risque nécessitent toujours votre confirmation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加のアクセスリクエストを自動承認し、通常のタスクをスムーズにします。高リスク操作は引き続き確認が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추가 접근 요청을 자동으로 승인하여 일상적인 작업이 원활하게 진행되도록 합니다. 고위험 작업은 여전히 확인이 필요합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprova automaticamente solicitações de acesso adicionais para manter as tarefas rotineiras fluindo. Operações de alto risco ainda exigem sua confirmação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动审核额外访问请求，让常规任务流转更顺畅。高风险操作仍会要求你确认。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動審核額外存取請求，讓常規任務流轉更順暢。高風險操作仍會要求你確認。"
          }
        }
      }
    },
