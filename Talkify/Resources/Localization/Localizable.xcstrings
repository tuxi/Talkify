        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuota semanal actual proviene de una tarjeta de reinicio"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le quota hebdomadaire actuel provient d'une carte de réinitialisation"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の週間クォータはリセットカードによるものです"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 주간 할당량은 재설정 카드에서 비롯됩니다"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cota semanal atual é de um cartão de redefinição"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前周额度来自重置卡"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前週額度來自重置卡"
          }
        }
      }
    },
    "workspace.reset_card_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Verwenden einer Reset-Karte beendet das aktuelle Wochenfenster und erstellt ein neues 7-Tage-Kontingent ab jetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using a reset card ends the current weekly window and creates a new 7-day quota starting now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar una tarjeta de reinicio finaliza la ventana semanal actual y crea una nueva cuota de 7 días a partir de ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'utilisation d'une carte de réinitialisation met fin à la fenêtre hebdomadaire actuelle et crée un nouveau quota de 7 jours à partir de maintenant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リセットカードを使用すると現在の週間ウィンドウが終了し、今から7日間の新しいクォータが作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재설정 카드를 사용하면 현재 주간 기간이 종료되고 지금부터 새로운 7일 할당량이 생성됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar um cartão de redefinição encerra a janela semanal atual e cria uma nova cota de 7 dias a partir de agora."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用重置卡会结束当前周窗口，并从现在开始创建新的 7 天额度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用重置卡會結束當前週窗口，並從現在開始創建新的 7 天額度。"
          }
        }
      }
    },
    "workspace.reset_confirm_warning" : {
