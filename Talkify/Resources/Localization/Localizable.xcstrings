    "billing.subscription.system_management_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können auch die App Store-Abonnementverwaltungsseite aufrufen, um den automatischen Verlängerungsstatus zu überprüfen, die Verlängerung zu kündigen oder systemseitige Abonnements zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also go to the App Store subscription management page to check your auto-renewal status, cancel renewal, or change system-side subscriptions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes ir a la página de administración de suscripciones de la App Store para verificar el estado de renovación automática, cancelar la renovación o cambiar las suscripciones del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez également accéder à la page de gestion des abonnements de l'App Store pour vérifier le statut de renouvellement automatique, annuler le renouvellement ou modifier les abonnements côté système."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeの公式サブスクリプション管理ページに移動して、自動更新の状態を確認したり、更新をキャンセルしたり、システム側のサブスクリプションを変更したりすることもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 공식 구독 관리 페이지로 이동하여 자동 갱신 상태를 확인하거나 갱신을 취소하거나 시스템 측 구독을 변경할 수도 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também pode acessar a página de gerenciamento de assinaturas da App Store para verificar o status de renovação automática, cancelar a renovação ou alterar assinaturas do sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你也可以前往 App Store 官方订阅管理页，查看自动续费状态、取消续费或变更系统侧订阅。"
          }
        },
        "zh-Hant" : {
