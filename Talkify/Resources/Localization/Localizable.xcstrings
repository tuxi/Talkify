        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proteger tus derechos, acepta el [Acuerdo de servicio de pago de Talkify (incluye renovación automática)](dreamai://vip-protocol)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour protéger vos droits, veuillez accepter le [Contrat de service payant Talkify (incluant les conditions de renouvellement automatique)](dreamai://vip-protocol)."
