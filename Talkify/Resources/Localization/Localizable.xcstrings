    "billing.restore_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dient zur Wiederherstellung noch nicht gutgeschriebener App Store-Transaktionen. Verbrauchbare Punktpakete können nicht wie Abonnements wiederhergestellt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
