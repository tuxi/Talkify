    "settings.full_access_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht den Zugriff auf Dateien und Befehle außerhalb des Arbeitsbereichs nach Autorisierung. Stellen Sie sicher, dass Sie die Risiken verstehen, bevor Sie dies aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow access to files and commands outside the workspace once authorized. Make sure you understand the risks before enabling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el acceso a archivos y comandos fuera del espacio de trabajo una vez autorizado. Asegúrate de entender los riesgos antes de habilitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet l'accès aux fichiers et commandes en dehors de l'espace de travail une fois autorisé. Assurez-vous de comprendre les risques avant d'activer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認後、ワークスペース外のファイルやコマンドへのアクセスを許可します。有効にする前にリスクを理解していることを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인 후 워크스페이스 외부의 파일 및 명령에 대한 접근을 허용합니다. 활성화하기 전에 위험을 이해했는지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite acesso a arquivos e comandos fora do espaço de trabalho após autorização. Certifique-se de entender os riscos antes de ativar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许在获得授权后访问工作空间之外的文件和命令。启用前请确认你了解相应风险。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許在獲得授權後存取工作空間之外的檔案和命令。啟用前請確認你了解相應風險。"
          }
        }
      }
    },
