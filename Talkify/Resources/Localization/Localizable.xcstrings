    "settings.type_delete_to_confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um versehentliches Löschen zu verhindern, geben Sie bitte DELETE ein, um zu bestätigen. Kontodaten, Anmeldeverknüpfungen und zugehörige Daten werden gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To prevent accidental deletion, please type DELETE to confirm. Account data, login bindings, and related data will enter the deletion process."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar eliminaciones accidentales, escribe DELETE para confirmar. Los datos de la cuenta, las vinculaciones de inicio de sesión y los datos relacionados entrarán en el proceso de eliminación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour éviter toute suppression accidentelle, veuillez taper DELETE pour confirmer. Les données du compte, les liaisons de connexion et les données associées entreront dans le processus de suppression."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誤操作を防ぐため、DELETEと入力して削除を確認してください。アカウントデータ、ログインバインディング、および関連データが削除プロセスに入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실수로 삭제하는 것을 방지하기 위해 DELETE를 입력하여 확인하세요. 계정 데이터, 로그인 연결 및 관련 데이터가 삭제 프로세스에 들어갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para evitar exclusão acidental, digite DELETE para confirmar. Os dados da conta, vínculos de login e dados relacionados entrarão no processo de exclusão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为避免误操作，请输入 DELETE 以确认删除。账号资料、登录绑定及相关数据将进入删除流程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為避免誤操作，請輸入 DELETE 以確認刪除。帳號資料、登入綁定及相關資料將進入刪除流程。"
          }
        }
      }
    },
