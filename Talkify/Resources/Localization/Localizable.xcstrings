          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para recuperar transacciones de App Store aún no acreditadas. Los paquetes de puntos consumibles no se pueden restaurar como las suscripciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
