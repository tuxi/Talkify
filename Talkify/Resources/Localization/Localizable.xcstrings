        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 입금되지 않은 App Store 거래를 복구하는 데 사용됩니다. 소비형 포인트 팩은 구독처럼 복원할 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para recuperar transações da App Store ainda não creditadas. Pacotes de pontos consumíveis não podem ser restaurados como assinaturas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于补发尚未入账的 App Store 交易；消耗型点数包不能像订阅一样恢复"
          }
        },
        "zh-Hant" : {
