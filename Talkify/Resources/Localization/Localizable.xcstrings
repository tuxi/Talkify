    "workspace.clone_default_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet standardmäßig flachen Klon, besser für mobile Netzwerke. Unterstützt nur öffentliche HTTPS-Repositories ohne Authentifizierung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses shallow clone by default, better for mobile networks. Only supports public HTTPS repositories that do not require authentication."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa clonación superficial por defecto, mejor para redes móviles. Solo admite repositorios HTTPS públicos sin autenticación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise un clonage superficiel par défaut, mieux adapté aux réseaux mobiles. Prend en charge uniquement les dépôts HTTPS publics sans authentification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトで浅いクローンを使用し、モバイルネットワークに適しています。認証が不要なHTTPSリポジトリのみサポートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 얕은 복제를 사용하며 모바일 네트워크에 더 적합합니다. 인증이 필요 없는 HTTPS 저장소만 지원합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa clone superficial por padrão, melhor para redes móveis. Suporta apenas repositórios HTTPS públicos sem autenticação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用浅克隆，更适合移动网络。仅支持无需登录的 HTTPS 仓库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設使用淺克隆，更適合行動網路。僅支援無需登入的 HTTPS 倉庫。"
          }
        }
      }
    },
