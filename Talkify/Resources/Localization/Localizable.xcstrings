    "share.cannot_open_agent" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quell-App erlaubt kein direktes Öffnen von CodeAgent. Beim nächsten Öffnen von Talkify erinnern wir Sie daran, einen Arbeitsbereich zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The source app does not allow opening CodeAgent directly. Next time you open Talkify, we'll remind you to create a workspace and start a conversation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app de origen no permite abrir CodeAgent directamente. La próxima vez que abras Talkify, te recordaremos crear un espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application source ne permet pas d'ouvrir directement CodeAgent. La prochaine fois que vous ouvrirez Talkify, nous vous rappellerons de créer un espace de travail."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ソースアプリはCodeAgentを直接開くことを許可していません。次回Talkifyを開いたときに、ワークスペースを作成して会話を開始するようお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "소스 앱에서 CodeAgent를 직접 열 수 없습니다. 다음에 Talkify를 열면 워크스페이스를 만들고 대화를 시작하라는 알림이 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app de origem não permite abrir o CodeAgent diretamente. Na próxima vez que abrir o Talkify, lembraremos você de criar um espaço de trabalho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前来源 App 不允许直接打开 CodeAgent。下次打开 Talkify 时，我们会提醒你创建工作区并开始对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前來源 App 不允許直接開啟 CodeAgent。下次開啟 Talkify 時，我們會提醒你建立工作區並開始對話。"
          }
        }
      }
    },
