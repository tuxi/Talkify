            "value" : "By default, Talkify can read and edit files in its workspace. Additional access may be requested when needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por defecto, Talkify puede leer y editar archivos en su espacio de trabajo. Se puede solicitar acceso adicional cuando sea necesario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Par défaut, Talkify peut lire et modifier les fichiers dans son espace de travail. Un accès supplémentaire peut être demandé si nécessaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デフォルトでは、Talkifyはワークスペース内のファイルを読み取り・編集できます。必要に応じて追加のアクセスが要求されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본적으로 Talkify는 워크스페이스의 파일을 읽고 편집할 수 있습니다. 필요 시 추가 접근 권한이 요청됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por padrão, o Talkify pode ler e editar arquivos em seu espaço de trabalho. Acesso adicional pode ser solicitado quando necessário."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认情况下，Talkify 可以读取和编辑其工作空间中的文件；需要时会请求额外访问权限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設情況下，Talkify 可以讀取和編輯其工作空間中的檔案；需要時會請求額外存取權限。"
          }
        }
      }
    },
    "settings.delete_account_confirm" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete Account?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar cuenta?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer le compte ?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제하시겠습니까?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir conta?"
          }
