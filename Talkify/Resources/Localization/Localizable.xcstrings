    "workspace.start_from_idea_desc" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Notwendigkeit, zuerst Code oder Dateien vorzubereiten. Erstellen Sie einen leeren Arbeitsbereich und sagen Sie CodeAgent, was Sie erstellen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No need to prepare code or files first. Create a blank workspace and tell CodeAgent what you want to build."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No necesitas preparar código o archivos primero. Crea un espacio de trabajo vacío y dile a CodeAgent lo que quieres construir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas besoin de préparer du code ou des fichiers d’abord. Créez un espace de travail vide et dites à CodeAgent ce que vous voulez construire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初にコードやファイルを準備する必要はありません。空のワークスペースを作成し、CodeAgentに構築したいものを伝えるだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "코드나 파일을 먼저 준비할 필요가 없습니다. 빈 워크스페이스를 만들고 CodeAgent에게 구축하려는 것을 알려주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não precisa preparar código ou arquivos primeiro. Crie um espaço de trabalho em branco e diga ao CodeAgent o que você quer construir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要先准备代码或文件。创建一个空白工作区，告诉 CodeAgent 你想构建什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要先準備程式碼或檔案。建立一個空白工作區，告訴 CodeAgent 你想構建什麼。"
          }
        }
      }
