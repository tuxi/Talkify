    "settings.delete_account_long_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Löschen Ihres Kontos entfernt Kontodaten, Anmeldeverknüpfungen und Zugriff auf zugehörige Daten. Dieser Vorgang ist in der Regel nicht umkehrbar. Bitte mit Vorsicht fortfahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account will remove account data, login bindings, and access to related data. This operation is generally irreversible. Please proceed with caution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar tu cuenta eliminará los datos de la cuenta, las vinculaciones de inicio de sesión y el acceso a los datos relacionados. Esta operación generalmente es irreversible. Procede con precaución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de votre compte supprimera les données du compte, les liaisons de connexion et l'accès aux données associées. Cette opération est généralement irréversible. Procédez avec prudence."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除すると、アカウントデータ、ログインバインディング、および関連データへのアクセスが削除されます。この操作は通常元に戻せません。慎重に進めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제하면 계정 데이터, 로그인 연결 및 관련 데이터 접근이 제거됩니다. 이 작업은 일반적으로 되돌릴 수 없습니다. 신중하게 진행하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir sua conta removerá dados da conta, vínculos de login e acesso a dados relacionados. Esta operação geralmente é irreversível. Proceda com cautela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除账号会清除账号资料、登录绑定和相关数据访问能力。该操作通常不可恢复，请谨慎处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除帳號會清除帳號資料、登入綁定和相關資料存取能力。該操作通常不可恢復，請謹慎處理。"
          }
        }
      }
    },
    "settings.delete_account_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Löschen Ihres Kontos werden Profil, Anmeldeverknüpfungen und zugehörige Daten gelöscht. Dieser Vorgang ist in der Regel nicht umkehrbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After deleting your account, your profile, login bindings, and related data will enter the deletion process. This operation is generally irreversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de eliminar tu cuenta, tu perfil, vinculaciones de inicio de sesión y datos relacionados entrarán en el proceso de eliminación. Esta operación generalmente es irreversible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après la suppression de votre compte, votre profil, vos liaisons de connexion et les données associées entreront dans le processus de suppression. Cette opération est généralement irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除すると、プロフィール、ログインバインディング、および関連データが削除プロセスに入ります。この操作は通常元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제하면 프로필, 로그인 연결 및 관련 데이터가 삭제 프로세스에 들어갑니다. 이 작업은 일반적으로 되돌릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após excluir sua conta, seu perfil, vínculos de login e dados relacionados entrarão no processo de exclusão. Esta operação geralmente é irreversível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除账号后，账号资料、登录绑定及相关数据将进入删除流程。该操作通常不可恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "刪除帳號後，帳號資料、登入綁定及相關資料將進入刪除流程。該操作通常不可恢復。"
          }
        }
      }
    },
